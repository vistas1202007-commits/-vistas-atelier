# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Admin panel (/admin) ---
ADMIN_PASSWORD=choose-a-long-random-password
# Optional: separate secret used to sign the login cookie
ADMIN_SECRET=another-long-random-string

# --- Enquiry storage (optional: Supabase) ---
# Leave empty on Netlify: enquiries are stored in Netlify Blobs automatically.
# Locally, without these, enquiries go to data/enquiries.json.
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Without a key, emails are skipped and logged to the console.
RESEND_API_KEY=
# Must use a domain you've verified in Resend
RESEND_FROM=Vistas Atelier <hello@vistasatelier.com>
# Where new-enquiry notifications go (defaults to the email in src/content/site.ts)
ENQUIRY_TO=
